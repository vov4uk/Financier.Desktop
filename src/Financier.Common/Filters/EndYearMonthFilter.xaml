<UserControl x:Class="Financier.Common.Filters.EndYearMonthFilter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fcrd="clr-namespace:Financier.Common.Entities"
             xmlns:loc="clr-namespace:Financier.Common.Localization"
             Width="120">
  <GroupBox Header="{loc:Translate Key=to_}"
            BorderThickness="0">
    <ComboBox Grid.Column="1"
              Margin="2 0"
              IsEditable="True"
              DisplayMemberPath="Name"
              SelectedItem="{Binding Path=EndYearMonths, UpdateSourceTrigger=PropertyChanged}"
              ItemsSource="{Binding Source={x:Static fcrd:DbManual.YearMonths}, Mode=OneWay}" />
  </GroupBox>
</UserControl>
