<UserControl
    x:Class="Financier.Common.Filters.TagFilter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fcrd="clr-namespace:Financier.Common.Entities"
    xmlns:loc="clr-namespace:Financier.Common.Localization"
    xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
    MinWidth="140">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Assets/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <GroupBox BorderThickness="0" Header="{loc:Translate Key=tag}">
        <xctk:CheckComboBox
            Width="140"
            Margin="2,0"
            Delimiter=" | "
            DisplayMemberPath="Title"
            ItemsSource="{Binding Source={x:Static fcrd:DbManual.Tag}, Mode=OneWay}"
            SelectedItemsOverride="{Binding Path=SelectedTags, Mode=TwoWay}"
            ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
    </GroupBox>
</UserControl>
