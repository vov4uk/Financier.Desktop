<UserControl
    x:Class="Financier.Desktop.Views.Controls.AccountControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ent="clr-namespace:Financier.Common.Entities;assembly=Financier.Common"
    xmlns:loc="clr-namespace:Financier.Common.Localization;assembly=Financier.Common"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="clr-namespace:Financier.Desktop.ViewModel.Dialog"
    xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
    d:DataContext="{d:DesignInstance {x:Type viewmodel:AccountControlVM},
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="760"
    d:DesignWidth="540"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Assets/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <GroupBox
        Margin="5"
        FontSize="12"
        Header="{loc:Translate Key=account_details}">
        <GroupBox.Resources>
            <Style TargetType="{x:Type xctk:IconButton}">
                <Setter Property="Height" Value="24" />
                <Setter Property="Width" Value="24" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </GroupBox.Resources>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                </Grid.ColumnDefinitions>

                <!--  Account Type  -->
                <GroupBox
                    Grid.Row="0"
                    Grid.ColumnSpan="2"
                    Margin="0,0,0,4"
                    BorderThickness="0"
                    Header="{loc:Translate Key=account_type}">
                    <!--<ComboBox ItemsSource="{Binding Source={loc:EnumBinding {x:Type ent:AccountType}}}" SelectedItem="{Binding SelectedAccountType, Mode=TwoWay}" />-->
                    <ComboBox
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding Source={loc:EnumBinding {x:Type ent:AccountType}}}"
                        SelectedItem="{Binding SelectedAccountType, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <!--<DataTemplate>
             <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
         </DataTemplate>-->

                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Image
                                        Width="24"
                                        Height="16"
                                        Margin="0,0,6,0">
                                        <Image.Source>
                                            <MultiBinding Converter="{StaticResource AccountTypeConverter}">
                                                <Binding />
                                                <Binding />
                                            </MultiBinding>
                                        </Image.Source>
                                    </Image>
                                    <TextBlock VerticalAlignment="Center" Text="{Binding}" />
                                </StackPanel>
                            </DataTemplate>

                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </GroupBox>

                <!--  Title  -->
                <GroupBox
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,0,2,4"
                    BorderThickness="0"
                    Header="{loc:Translate Key=title}">
                    <TextBox MinHeight="20" Text="{Binding Entity.Title, UpdateSourceTrigger=PropertyChanged}" />
                </GroupBox>
                <xctk:IconButton
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="0,0,0,8"
                    VerticalAlignment="Bottom"
                    Command="{Binding ClearTitleCommand}">
                    <xctk:IconButton.Icon>
                        <Image
                            Width="16"
                            Height="16"
                            Source="{StaticResource IconXmark}" />
                    </xctk:IconButton.Icon>
                </xctk:IconButton>

                <!--  Currency  -->
                <GroupBox
                    Grid.Row="2"
                    Grid.ColumnSpan="2"
                    Margin="0,0,0,4"
                    BorderThickness="0"
                    Header="{loc:Translate Key=currency}">
                    <ComboBox
                        DisplayMemberPath="Name"
                        ItemsSource="{Binding Currencies}"
                        SelectedItem="{Binding SelectedCurrency, Mode=TwoWay}" />
                </GroupBox>

                <!--  Card Issuer (card types only)  -->
                <GroupBox
                    Grid.Row="3"
                    Grid.ColumnSpan="2"
                    Margin="0,0,0,4"
                    BorderThickness="0"
                    Header="{loc:Translate Key=card_issuer}"
                    Visibility="{Binding ShowCardIssuer, Converter={StaticResource BoolToVis}}">
                    <ComboBox ItemsSource="{Binding Source={loc:EnumBinding {x:Type ent:CardIssuer}}}" SelectedItem="{Binding SelectedCardIssuer, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Image
                                        Width="24"
                                        Height="16"
                                        Margin="0,0,6,0">
                                        <Image.Source>
                                            <MultiBinding Converter="{StaticResource AccountTypeConverter}">
                                                <Binding Source="CREDIT_CARD" />
                                                <Binding />
                                            </MultiBinding>
                                        </Image.Source>
                                    </Image>
                                    <TextBlock VerticalAlignment="Center" Text="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </GroupBox>

                <!--  Electronic Payment Type (electronic only)  -->
                <GroupBox
                    Grid.Row="4"
                    Grid.ColumnSpan="2"
                    Margin="0,0,0,4"
                    BorderThickness="0"
                    Header="{loc:Translate Key=electronic_payment_type}"
                    Visibility="{Binding ShowElectronicType, Converter={StaticResource BoolToVis}}">
                    <ComboBox ItemsSource="{Binding Source={loc:EnumBinding {x:Type ent:ElectronicType}}}" SelectedItem="{Binding SelectedElectronicType, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Image
                                        Width="24"
                                        Height="16"
                                        Margin="0,0,6,0">
                                        <Image.Source>
                                            <MultiBinding Converter="{StaticResource AccountTypeConverter}">
                                                <Binding Source="ELECTRONIC" />
                                                <Binding />
                                            </MultiBinding>
                                        </Image.Source>
                                    </Image>
                                    <TextBlock VerticalAlignment="Center" Text="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </GroupBox>

                <!--  Issuer Name (card + electronic)  -->
                <GroupBox
                    Grid.Row="5"
                    Grid.ColumnSpan="2"
                    Margin="0,0,0,4"
                    BorderThickness="0"
                    Header="{loc:Translate Key=issuer}"
                    Visibility="{Binding ShowIssuer, Converter={StaticResource BoolToVis}}">
                    <TextBox MinHeight="20" Text="{Binding Entity.Issuer, UpdateSourceTrigger=PropertyChanged}" />
                </GroupBox>

                <!--  Card Number (card types only)  -->
                <GroupBox
                    Grid.Row="6"
                    Grid.ColumnSpan="2"
                    Margin="0,0,0,4"
                    BorderThickness="0"
                    Header="{loc:Translate Key=card_number}"
                    Visibility="{Binding ShowNumber, Converter={StaticResource BoolToVis}}">
                    <TextBox MinHeight="20" Text="{Binding Entity.Number, UpdateSourceTrigger=PropertyChanged}" />
                </GroupBox>

                <!--  Limit Amount (credit card only)  -->
                <GroupBox
                    Grid.Row="7"
                    Grid.ColumnSpan="2"
                    Margin="0,0,0,4"
                    BorderThickness="0"
                    Header="{loc:Translate Key=limit_amount}"
                    Visibility="{Binding ShowCreditCardFields, Converter={StaticResource BoolToVis}}">
                    <TextBox MinHeight="20" Text="{Binding Entity.LimitAmount, UpdateSourceTrigger=PropertyChanged}" />
                </GroupBox>

                <!--  Closing Day (credit card only)  -->
                <GroupBox
                    Grid.Row="8"
                    Grid.ColumnSpan="2"
                    Margin="0,0,0,4"
                    BorderThickness="0"
                    Header="{loc:Translate Key=closing_day}"
                    Visibility="{Binding ShowCreditCardFields, Converter={StaticResource BoolToVis}}">
                    <TextBox MinHeight="20" Text="{Binding Entity.ClosingDay, UpdateSourceTrigger=PropertyChanged}" />
                </GroupBox>

                <!--  Payment Day (credit card only)  -->
                <GroupBox
                    Grid.Row="9"
                    Grid.ColumnSpan="2"
                    Margin="0,0,0,4"
                    BorderThickness="0"
                    Header="{loc:Translate Key=payment_day}"
                    Visibility="{Binding ShowCreditCardFields, Converter={StaticResource BoolToVis}}">
                    <TextBox MinHeight="20" Text="{Binding Entity.PaymentDay, UpdateSourceTrigger=PropertyChanged}" />
                </GroupBox>

                <!--  Opening Amount (new accounts only)  -->
                <GroupBox
                    Grid.Row="10"
                    Grid.ColumnSpan="2"
                    Margin="0,0,0,4"
                    BorderThickness="0"
                    Header="{loc:Translate Key=opening_amount}"
                    Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}">
                    <TextBox MinHeight="20" Text="{Binding Entity.OpeningAmount, UpdateSourceTrigger=PropertyChanged}" />
                </GroupBox>

                <!--  Note  -->
                <GroupBox
                    Grid.Row="11"
                    Grid.ColumnSpan="2"
                    Margin="0,0,0,4"
                    BorderThickness="0"
                    Header="{loc:Translate Key=note}">
                    <TextBox
                        MinHeight="40"
                        AcceptsReturn="True"
                        MinLines="2"
                        Text="{Binding Entity.Note, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap" />
                </GroupBox>

                <!--  Sort Order  -->
                <GroupBox
                    Grid.Row="12"
                    Grid.ColumnSpan="2"
                    Margin="0,0,0,4"
                    BorderThickness="0"
                    Header="{loc:Translate Key=sort_order}">
                    <TextBox MinHeight="20" Text="{Binding Entity.SortOrder, UpdateSourceTrigger=PropertyChanged}" />
                </GroupBox>

                <!--  Checkboxes  -->
                <StackPanel
                    Grid.Row="13"
                    Grid.ColumnSpan="2"
                    Margin="4,4,0,8"
                    Orientation="Horizontal">
                    <CheckBox
                        Margin="0,0,16,0"
                        Content="{loc:Translate Key=is_active}"
                        IsChecked="{Binding Entity.IsActive}" />
                    <CheckBox Content="{loc:Translate Key=is_include_into_totals}" IsChecked="{Binding Entity.IsIncludeIntoTotals}" />
                </StackPanel>

                <!--  Save / Cancel  -->
                <Grid
                    Grid.Row="14"
                    Grid.ColumnSpan="2"
                    Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Grid.Column="0"
                        Margin="2"
                        Command="{Binding SaveCommand}"
                        Content="{loc:Translate Key=save}" />
                    <Button
                        Grid.Column="1"
                        Margin="2"
                        Command="{Binding CancelCommand}"
                        Content="{loc:Translate Key=cancel}" />
                </Grid>
            </Grid>
        </ScrollViewer>
    </GroupBox>
</UserControl>
