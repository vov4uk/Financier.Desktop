<UserControl x:Class="Financier.Desktop.Views.Controls.CategoryControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:loc="clr-namespace:Financier.Common.Localization;assembly=Financier.Common"
             xmlns:viewmodel="clr-namespace:Financier.Desktop.ViewModel.Dialog"
             xmlns:converters="clr-namespace:Financier.Converters;assembly=Financier.Common"
             d:DataContext="{d:DesignInstance {x:Type viewmodel:CategoryControlVM}, IsDesignTimeCreatable=False}"
             mc:Ignorable="d"
             d:DesignHeight="300"
             d:DesignWidth="400">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Assets/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:InverseBooleanConverter x:Key="InverseBool" />
        </ResourceDictionary>
    </UserControl.Resources>
    <GroupBox Margin="5"
              Header="{loc:Translate Key=category_details}"
              FontSize="12">
        <GroupBox.Resources>
            <Style TargetType="{x:Type Image}">
                <Setter Property="Height" Value="20" />
                <Setter Property="Width" Value="20" />
            </Style>
            <Style TargetType="{x:Type xctk:IconButton}">
                <Setter Property="Height" Value="24" />
                <Setter Property="Width" Value="24" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </GroupBox.Resources>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" MaxHeight="28" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" MaxHeight="24" />
                <RowDefinition Height="Auto" MaxHeight="24" />
                <RowDefinition Height="Auto" MaxHeight="24" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
            </Grid.ColumnDefinitions>

            <!-- Parent Category -->
            <TextBlock Grid.Column="0"
                       Grid.Row="0"
                       Grid.ColumnSpan="2"
                       Text="{loc:Translate Key=parent_category}" />
            <ComboBox Grid.Column="0"
                      Grid.Row="1"
                      Grid.ColumnSpan="2"
                      IsEditable="True"
                      ItemTemplate="{StaticResource ResourceKey=CategoryTemplate}"
                      TextSearch.TextPath="Title"
                      SelectedItem="{Binding SelectedParent, UpdateSourceTrigger=PropertyChanged}"
                      ItemsSource="{Binding AvailableParents}" />

            <!-- Title -->
            <TextBlock Grid.Column="0"
                       Grid.Row="2"
                       Grid.ColumnSpan="2"
                       Margin="0 8 0 0"
                       Text="{loc:Translate Key=title}" />
            <TextBox Grid.Column="0"
                     Grid.Row="3"
                     Text="{Binding Entity.Title, UpdateSourceTrigger=PropertyChanged}" />
            <xctk:IconButton Grid.Column="1"
                             Grid.Row="3"
                             Height="24"
                             Width="24"
                             Command="{Binding ClearTitleCommand}">
                <xctk:IconButton.Icon>
                    <Image Source="{StaticResource IconXmark}" Height="16" Width="16" />
                </xctk:IconButton.Icon>
            </xctk:IconButton>

            <!-- Income / Expense -->
            <StackPanel Grid.Column="0"
                        Grid.Row="4"
                        Grid.ColumnSpan="2"
                        Margin="0 8 0 0"
                        Orientation="Horizontal"
                        IsEnabled="{Binding IsTypeEnabled}">
                <RadioButton Content="{loc:Translate Key=expense}"
                             IsChecked="{Binding Entity.IsIncome, Converter={StaticResource InverseBool}}"
                             Margin="0 0 16 0" />
                <RadioButton Content="{loc:Translate Key=income}"
                             IsChecked="{Binding Entity.IsIncome}" />
            </StackPanel>

            <!-- Save / Cancel -->
            <Grid Grid.Row="6"
                  Margin="0 24 0 0"
                  Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Margin="2"
                        Command="{Binding SaveCommand}"
                        Content="{loc:Translate Key=save}" />
                <Button Grid.Column="1" Margin="2"
                        Command="{Binding CancelCommand}"
                        Content="{loc:Translate Key=cancel}" />
            </Grid>
        </Grid>
    </GroupBox>
</UserControl>
