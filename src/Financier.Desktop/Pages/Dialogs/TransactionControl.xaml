<UserControl
    x:Class="Financier.Desktop.Views.TransactionControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Financier.Converters;assembly=Financier.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialog="clr-namespace:Financier.Desktop.ViewModel.Dialog"
    xmlns:emoji="http://schemas.inkore.net/lib/ui/wpf/emojis"
    xmlns:entities="clr-namespace:Financier.Desktop.Views"
    xmlns:fcrd="clr-namespace:Financier.Common.Entities;assembly=Financier.Common"
    xmlns:loc="clr-namespace:Financier.Common.Localization;assembly=Financier.Common"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:viewmodel="clr-namespace:Financier.Desktop.Data"
    xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
    d:DataContext="{d:DesignInstance {x:Type dialog:TransactionControlVM},
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="450"
    d:DesignWidth="400"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Assets/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <converters:AmountConverter x:Key="AmountConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <GroupBox
        Margin="5"
        Background="{StaticResource WindowBackgroundBrush}"
        FontSize="12"
        Header="{loc:Translate Key=transaction_details}">
        <GroupBox.Resources>
            <Style TargetType="{x:Type Image}">
                <Setter Property="Height" Value="20" />
                <Setter Property="Width" Value="20" />
            </Style>
            <Style TargetType="{x:Type xctk:IconButton}">
                <Setter Property="Height" Value="24" />
                <Setter Property="Width" Value="24" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </GroupBox.Resources>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="24" />
            </Grid.RowDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <!--  Account  -->
                        <RowDefinition Height="15" />
                        <RowDefinition Height="24" />
                        <!--  payee  -->
                        <RowDefinition Height="15" />
                        <RowDefinition Height="24" />
                        <!--  Category  -->
                        <RowDefinition Height="15" />
                        <RowDefinition Height="24" />
                        <!--  Currenct  -->
                        <RowDefinition Height="15" />
                        <RowDefinition Height="24" />
                        <!--  amount  -->
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <!--  Spit  -->
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />

                        <!--  location  -->
                        <RowDefinition Height="15" />
                        <RowDefinition Height="24" />
                        <!--  note  -->
                        <RowDefinition Height="15" />
                        <RowDefinition Height="24" />
                        <!--  project  -->
                        <RowDefinition Height="15" />
                        <RowDefinition Height="24" />
                        <!--  tag  -->
                        <RowDefinition Height="15" />
                        <RowDefinition Height="24" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                    </Grid.ColumnDefinitions>

                    <Grid
                        Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <xctk:IconButton
                            Grid.Row="0"
                            Grid.Column="0"
                            IsEnabled="False">
                            <xctk:IconButton.Icon>
                                <Image
                                    Width="16"
                                    Height="16"
                                    Source="{StaticResource ResourceKey=IconCircleInfo}" />
                            </xctk:IconButton.Icon>
                        </xctk:IconButton>
                        <DatePicker
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="2"
                            SelectedDate="{Binding Transaction.Date}" />
                        <xctk:TimePicker
                            Grid.Row="0"
                            Grid.Column="2"
                            Grid.ColumnSpan="2"
                            Margin="2"
                            HorizontalAlignment="Stretch"
                            Value="{Binding Transaction.Time}" />
                    </Grid>

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Text="{loc:Translate Key=account}" />
                    <ComboBox
                        Grid.Row="2"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        IsEditable="True"
                        ItemTemplate="{StaticResource ResourceKey=IActive}"
                        ItemsSource="{Binding Source={x:Static fcrd:DbManual.Account}, Mode=OneWay}"
                        SelectedItem="{Binding Transaction.FromAccount}"
                        SelectedValue="{Binding Transaction.FromAccountId}"
                        SelectedValuePath="Id"
                        TextSearch.TextPath="Title" />

                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Text="{loc:Translate Key=payee}" />
                    <xctk:WatermarkComboBox
                        Grid.Row="4"
                        Grid.Column="0"
                        IsEditable="True"
                        ItemTemplate="{StaticResource ResourceKey=IActive}"
                        ItemsSource="{Binding Source={x:Static fcrd:DbManual.Payee}, Mode=OneWay}"
                        SelectedValue="{Binding Transaction.PayeeId}"
                        SelectedValuePath="Id"
                        TextSearch.TextPath="Title" />
                    <xctk:IconButton
                        Grid.Row="4"
                        Grid.Column="1"
                        Command="{Binding ClearPayeeCommand}">
                        <xctk:IconButton.Icon>
                            <Image
                                Width="16"
                                Height="16"
                                Source="{StaticResource IconXmark}" />
                        </xctk:IconButton.Icon>
                    </xctk:IconButton>

                    <TextBlock
                        Grid.Row="5"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Text="{loc:Translate Key=category}" />

                    <Grid
                        Grid.Row="6"
                        Grid.Column="0"
                        Grid.ColumnSpan="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="24" />
                        </Grid.ColumnDefinitions>
                        <xctk:WatermarkComboBox
                            Grid.Column="0"
                            IsEditable="True"
                            ItemTemplate="{StaticResource ResourceKey=CategoryTemplate}"
                            ItemsSource="{Binding Source={x:Static fcrd:DbManual.Category}, Mode=OneWay}"
                            SelectedItem="{Binding Transaction.Category}"
                            SelectedValue="{Binding Transaction.CategoryId}"
                            SelectedValuePath="Id"
                            TextSearch.TextPath="Title" />
                        <xctk:IconButton Grid.Column="1" Command="{Binding ClearCategoryCommand}">
                            <xctk:IconButton.CommandParameter>
                                <sys:Int32>-1</sys:Int32>
                            </xctk:IconButton.CommandParameter>
                            <xctk:IconButton.Icon>
                                <Image
                                    Width="16"
                                    Height="16"
                                    Source="{StaticResource IconShareNodes}" />
                            </xctk:IconButton.Icon>
                        </xctk:IconButton>
                        <xctk:IconButton Grid.Column="2" Command="{Binding ClearCategoryCommand}">
                            <xctk:IconButton.CommandParameter>
                                <sys:Int32>0</sys:Int32>
                            </xctk:IconButton.CommandParameter>
                            <xctk:IconButton.Icon>
                                <Image
                                    Width="16"
                                    Height="16"
                                    Source="{StaticResource IconXmark}" />
                            </xctk:IconButton.Icon>
                        </xctk:IconButton>
                    </Grid>

                    <TextBlock
                        Grid.Row="7"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Text="{loc:Translate Key=currency}" />
                    <xctk:WatermarkComboBox
                        Grid.Row="8"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        DisplayMemberPath="Title"
                        ItemsSource="{Binding Source={x:Static fcrd:DbManual.Currencies}, Mode=OneWay}"
                        SelectedItem="{Binding Transaction.OriginalCurrency}"
                        SelectedValue="{Binding Transaction.OriginalCurrencyId}"
                        SelectedValuePath="Id"
                        Watermark="{loc:Translate Key=same_as_account}" />

                    <entities:AmountControl
                        Grid.Row="10"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        DataContext="{Binding}" />

                    <Border
                        Grid.Row="11"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        BorderBrush="LightGray"
                        BorderThickness="0,1,0,1"
                        Visibility="{Binding Transaction.IsSplitCategory, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="24" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="15" />
                                <RowDefinition Height="15" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Text="{loc:Translate Key=unsplit_amount}" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Text="{Binding Transaction.UnsplitAmount, Converter={StaticResource AmountConverter}, ConverterParameter=false, StringFormat=F2, Mode=OneWay}" />
                            <xctk:IconButton
                                Grid.Row="0"
                                Grid.RowSpan="2"
                                Grid.Column="1"
                                Margin="0,3,0,0"
                                VerticalAlignment="Top"
                                Command="{Binding OpenRecipesDialogCommand}"
                                ToolTip="{loc:Translate Key=open_recipes_wizard}">
                                <xctk:IconButton.Icon>
                                    <Image
                                        Width="16"
                                        Height="16"
                                        Source="{StaticResource ResourceKey=IconReceiptBlack}" />
                                </xctk:IconButton.Icon>
                            </xctk:IconButton>
                            <xctk:IconButton
                                Grid.Row="0"
                                Grid.RowSpan="2"
                                Grid.Column="2"
                                Margin="0,3,0,0"
                                VerticalAlignment="Top"
                                Command="{Binding AddSubTransferCommand}"
                                ToolTip="{loc:Translate Key=add_split_transfers}">
                                <xctk:IconButton.Icon>
                                    <Image
                                        Width="16"
                                        Height="16"
                                        Source="{StaticResource ResourceKey=IconArrowRightArrowLeft}" />
                                </xctk:IconButton.Icon>
                            </xctk:IconButton>
                            <xctk:IconButton
                                Grid.Row="0"
                                Grid.RowSpan="2"
                                Grid.Column="3"
                                Margin="0,3,0,0"
                                VerticalAlignment="Top"
                                Command="{Binding AddSubTransactionCommand}"
                                ToolTip="{loc:Translate Key=add_split_transactions}">
                                <xctk:IconButton.Icon>
                                    <Image
                                        Width="16"
                                        Height="16"
                                        Source="{StaticResource IconPlus}" />
                                </xctk:IconButton.Icon>
                            </xctk:IconButton>
                        </Grid>
                    </Border>

                    <ListBox
                        Grid.Row="12"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        HorizontalContentAlignment="Stretch"
                        DataContext="{Binding}"
                        ItemsSource="{Binding Transaction.SubTransactions}">
                        <ListBox.Style>
                            <Style TargetType="ListBox">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Transaction.IsSplitCategory}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewmodel:TransactionDto}">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="24" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.InputBindings>
                                        <MouseBinding
                                            Command="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListBox}}, Path=DataContext.EditSubTransactionCommand}"
                                            CommandParameter="{Binding}"
                                            MouseAction="LeftDoubleClick" />
                                    </Grid.InputBindings>
                                    <Grid.Style>
                                        <Style TargetType="{x:Type Grid}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAmountNegative, UpdateSourceTrigger=PropertyChanged}" Value="true">
                                                    <DataTrigger.Setters>
                                                        <Setter Property="Background" Value="LightPink" />
                                                    </DataTrigger.Setters>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsAmountNegative, UpdateSourceTrigger=PropertyChanged}" Value="false">
                                                    <DataTrigger.Setters>
                                                        <Setter Property="Background" Value="YellowGreen" />
                                                    </DataTrigger.Setters>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <emoji:EmojiedTextBlock
                                        Grid.Column="0"
                                        Margin="5,0,0,0"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center"
                                        Text="{Binding SubTransactionTitle}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="0,0,5,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Text="{Binding FromAmount, Converter={StaticResource AmountConverter}, StringFormat=F2, ConverterParameter=false}" />
                                    <xctk:IconButton
                                        Grid.Column="2"
                                        Command="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListBox}}, Path=DataContext.DeleteSubTransactionCommand}"
                                        CommandParameter="{Binding}">
                                        <xctk:IconButton.Icon>
                                            <Image
                                                Width="16"
                                                Height="16"
                                                Source="{StaticResource IconMinus}" />
                                        </xctk:IconButton.Icon>
                                    </xctk:IconButton>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock
                        Grid.Row="13"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Text="{loc:Translate Key=location}" />
                    <xctk:WatermarkComboBox
                        Grid.Row="14"
                        Grid.Column="0"
                        IsEditable="True"
                        ItemTemplate="{StaticResource ResourceKey=IActive}"
                        ItemsSource="{Binding Source={x:Static fcrd:DbManual.Location}, Mode=OneWay}"
                        SelectedValue="{Binding Transaction.LocationId}"
                        SelectedValuePath="Id"
                        TextSearch.TextPath="Title" />
                    <xctk:IconButton
                        Grid.Row="14"
                        Grid.Column="1"
                        Command="{Binding ClearLocationCommand}">
                        <xctk:IconButton.Icon>
                            <Image
                                Width="16"
                                Height="16"
                                Source="{StaticResource IconXmark}" />
                        </xctk:IconButton.Icon>
                    </xctk:IconButton>

                    <TextBlock
                        Grid.Row="15"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Text="{loc:Translate Key=note}" />
                    <TextBox
                        Grid.Row="16"
                        Grid.Column="0"
                        Text="{Binding Transaction.Note}" />
                    <xctk:IconButton
                        Grid.Row="16"
                        Grid.Column="1"
                        Command="{Binding ClearNotesCommand}">
                        <xctk:IconButton.Icon>
                            <Image
                                Width="16"
                                Height="16"
                                Source="{StaticResource IconXmark}" />
                        </xctk:IconButton.Icon>
                    </xctk:IconButton>

                    <TextBlock
                        Grid.Row="17"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Text="{loc:Translate Key=project}"
                        Visibility="{Binding ElementName=ProjectIdBox, Path=Visibility}" />

                    <xctk:WatermarkComboBox
                        x:Name="ProjectIdBox"
                        Grid.Row="18"
                        Grid.Column="0"
                        IsEditable="True"
                        ItemTemplate="{StaticResource ResourceKey=IActive}"
                        ItemsSource="{Binding Source={x:Static fcrd:DbManual.Project}, Mode=OneWay}"
                        SelectedValue="{Binding Transaction.ProjectId}"
                        SelectedValuePath="Id"
                        TextSearch.TextPath="Title">
                        <xctk:WatermarkComboBox.Style>
                            <Style TargetType="xctk:WatermarkComboBox">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Transaction.IsSplitCategory}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </xctk:WatermarkComboBox.Style>
                    </xctk:WatermarkComboBox>
                    <xctk:IconButton
                        Grid.Row="18"
                        Grid.Column="1"
                        Command="{Binding ClearProjectCommand}"
                        Visibility="{Binding ElementName=ProjectIdBox, Path=Visibility}">
                        <xctk:IconButton.Icon>
                            <Image
                                Width="16"
                                Height="16"
                                Source="{StaticResource IconXmark}" />
                        </xctk:IconButton.Icon>
                    </xctk:IconButton>

                    <TextBlock
                        Grid.Row="19"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Text="{loc:Translate Key=tag}" />
                    <xctk:CheckComboBox
                        Grid.Row="20"
                        Grid.Column="0"
                        Delimiter=" | "
                        DisplayMemberPath="Title"
                        ItemsSource="{Binding Source={x:Static fcrd:DbManual.Tag}, Mode=OneWay}"
                        SelectedItemsOverride="{Binding Transaction.SelectedTags, Mode=TwoWay}" />
                    <xctk:IconButton
                        Grid.Row="20"
                        Grid.Column="1"
                        Command="{Binding ClearTagCommand}">
                        <xctk:IconButton.Icon>
                            <Image
                                Width="16"
                                Height="16"
                                Source="{StaticResource IconXmark}" />
                        </xctk:IconButton.Icon>
                    </xctk:IconButton>
                </Grid>
            </ScrollViewer>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    Grid.Column="0"
                    Margin="2"
                    Command="{Binding SaveCommand}"
                    Content="{loc:Translate Key=save}" />
                <Button
                    Grid.Column="1"
                    Margin="2"
                    Command="{Binding CancelCommand}"
                    Content="{loc:Translate Key=cancel}" />
            </Grid>
        </Grid>
    </GroupBox>
</UserControl>
