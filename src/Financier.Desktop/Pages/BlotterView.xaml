<UserControl x:Class="Financier.Desktop.Views.BlotterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dgx="clr-namespace:DataGridExtensions;assembly=DataGridExtensions"
             xmlns:emoji="http://schemas.inkore.net/lib/ui/wpf/emojis"
             xmlns:loc="clr-namespace:Financier.Common.Localization;assembly=Financier.Common"
             xmlns:filters="clr-namespace:Financier.Common.Filters;assembly=Financier.Common"
             xmlns:converters="clr-namespace:Financier.Converters;assembly=Financier.Common"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d"
             d:DesignHeight="480"
             d:DesignWidth="1000">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Assets/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:NullToVisibilityConverter x:Key="ToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Expander Margin="5"
                  Grid.Row="0"
                  Grid.Column="1"
                  Grid.RowSpan="2"
                  IsExpanded="True"
                  Background="Transparent"
                  ExpandDirection="Left">
            <StackPanel Orientation="Vertical">
                <filters:PeriodFilter  Margin="0"
                                       SelectedPeriodType="{Binding PeriodType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       DataContext="{Binding}"
                                       Orientation="Vertical"/>
                <filters:AccountFilter Margin="4" />
                <filters:CategoryFilter Margin="4" />
                <filters:ProjectFilter Margin="4" />
                <filters:PayeeFilter Margin="4" />
                <filters:LocationFilter Margin="4" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Button ToolTip="{loc:Translate Key=refresh}"
                            Height="24"
                            Width="24"
                            BorderThickness="0"
                            Background="Transparent"
                            Grid.Column="0"
                            Command="{Binding RefreshDataCommand}"
                            Margin="4">
                        <Image Source="{StaticResource ResourceKey=IconRefresh}" Width="16" Height="16"/>
                    </Button>
                    <Button ToolTip="{loc:Translate Key=clear}"
                            Height="24"
                            Width="24"
                            BorderThickness="0"
                            Background="Transparent"
                            Grid.Column="1"
                            Command="{Binding ClearFiltersCommand}"
                            Margin="4">
                        <Image Source="{StaticResource ResourceKey=IconClearFilters}" Width="16" Height="16"/>
                    </Button>
                </Grid>

            </StackPanel>
        </Expander>
        <DataGrid Grid.Row="0"
                  Grid.Column="0"
                  Margin="5"
                  x:Name="TransactionsGrid"
                  IsSynchronizedWithCurrentItem="True"
                  ItemsSource="{Binding Path=Entities}"
                  AutoGenerateColumns="False"
                  SelectedItem="{Binding SelectedValue, UpdateSourceTrigger=Default}"
                  ScrollViewer.CanContentScroll="True"
                  IsReadOnly="True"
                  CanUserAddRows="false"
                  dgx:DataGridFilter.IsAutoFilterEnabled="True"
                  SelectionUnit="FullRow"
                  SelectionMode="Extended"
                  ClipboardCopyMode="ExcludeHeader"
                  FontSize="14">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="SelectedCellsChanged">
                    <i:InvokeCommandAction Command="{Binding SelectionChangedCommand}"
                                           CommandParameter="{Binding SelectedCells, ElementName=TransactionsGrid}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>
            <DataGrid.InputBindings>
                <MouseBinding
                    MouseAction="LeftDoubleClick"
                    Command="{Binding EditCommand}"
                    CommandParameter="{Binding SelectedValue}" />
            </DataGrid.InputBindings>
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Path=Id}"
                                    dgx:DataGridFilterColumn.IsFilterVisible="False" />
                <DataGridTemplateColumn Header=""
                                        ClipboardContentBinding="{Binding Path=Type}"
                                        dgx:DataGridFilterColumn.IsFilterVisible="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Name="MyImage" Source="{StaticResource IconSquareUpRight}" Width="20" Height="20" />
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Path=Type}" Value="Transfer">
                                    <Setter TargetName="MyImage" Property="Source" Value="{StaticResource IconUpRightAndDownLeftFromCenter}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Path=Type}" Value="Income">
                                    <Setter TargetName="MyImage" Property="Source" Value="{StaticResource IconSquareDownRight}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Path=Type}" Value="Share">
                                    <Setter TargetName="MyImage" Property="Source" Value="{StaticResource IconShareNodesRed}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{loc:Translate Key=time}"
                                    dgx:DataGridFilterColumn.IsFilterVisible="False"
                                    Binding="{Binding Path=Datetime, Converter= {StaticResource DatetimeConverter}}" />
                <DataGridTextColumn Header=""
                                    Binding="{Binding Path=AccountTitle}" />
                <DataGridTemplateColumn Header=""
                                        ClipboardContentBinding="{Binding Path=TransactionTitle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <emoji:EmojiedTextBlock Text="{Binding Path=TransactionTitle}" x:Name="Cell"/>
                                <TextBlock x:Name="Separator"
                                           Text=" | "
                                           Visibility="{Binding Project, Converter={StaticResource ToVisibilityConverter}}"
                                           />
                                <emoji:EmojiedTextBlock x:Name="prj" Text="{Binding Project.Title}" Foreground="DarkGreen" />
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Path=HasNoCategory}" Value="True">
                                    <Setter TargetName="Cell" Property="Background" Value="Pink" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Project.IsActive}" Value="False">
                                    <DataTrigger.Setters>
                                        <Setter TargetName="prj" Property="Foreground" Value="DarkRed"/>
                                    </DataTrigger.Setters>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{loc:Translate Key=amount}"
                                        dgx:DataGridFilterColumn.IsFilterVisible="False"
                                        ClipboardContentBinding="{Binding Path=AmountClipboardText}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Name="MyText" Text="{Binding Path=AmountTitle}"
                                       HorizontalAlignment="Right"/>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Path=Type}" Value="Transfer">
                                    <Setter TargetName="MyText" Property="Foreground" Value="DarkOrange" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Path=Type}" Value="Income">
                                    <Setter TargetName="MyText" Property="Foreground" Value="DarkGreen" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Path=Type}" Value="Share">
                                    <Setter TargetName="MyText" Property="Foreground" Value="DarkRed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Path=Type}" Value="Expense">
                                    <Setter TargetName="MyText" Property="Foreground" Value="DarkRed" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{loc:Translate Key=balance}"
                                    Binding="{Binding Path=BalanceTitle}"
                                    dgx:DataGridFilterColumn.IsFilterVisible="False">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Border Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="1"
                Margin="5,0,5,5"
                Padding="6,3"
                Background="#FFF0F0F0"
                BorderBrush="#FFCCCCCC"
                BorderThickness="1">
            <TextBlock Text="{Binding SelectionSummary}"
                       FontSize="14"
                       FontWeight="Bold"
                       HorizontalAlignment="Right" />
        </Border>
    </Grid>
</UserControl>
