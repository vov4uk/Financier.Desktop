<UserControl
    x:Class="Financier.Desktop.Views.BlotterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Financier.Converters;assembly=Financier.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dgx="clr-namespace:DataGridExtensions;assembly=DataGridExtensions"
    xmlns:emoji="http://schemas.inkore.net/lib/ui/wpf/emojis"
    xmlns:filters="clr-namespace:Financier.Common.Filters;assembly=Financier.Common"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:loc="clr-namespace:Financier.Common.Localization;assembly=Financier.Common"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="480"
    d:DesignWidth="1000"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Assets/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:NullToVisibilityConverter x:Key="ToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Expander
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="1"
            Margin="5"
            Background="Transparent"
            ExpandDirection="Left"
            IsExpanded="True">
            <StackPanel Orientation="Vertical">
                <filters:PeriodFilter
                    Margin="0"
                    DataContext="{Binding}"
                    Orientation="Vertical"
                    SelectedPeriodType="{Binding PeriodType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <filters:AccountsFilter Margin="4" />
                <filters:CategoryFilter Margin="4" />
                <filters:ProjectFilter Margin="4" />
                <filters:PayeeFilter Margin="4" />
                <filters:LocationFilter Margin="4" />
                <filters:TagFilter Margin="4" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Button
                        Grid.Column="0"
                        Width="24"
                        Height="24"
                        Margin="4"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding RefreshDataCommand}"
                        ToolTip="{loc:Translate Key=refresh}">
                        <Image
                            Width="16"
                            Height="16"
                            Source="{StaticResource ResourceKey=IconRefresh}" />
                    </Button>
                    <Button
                        Grid.Column="1"
                        Width="24"
                        Height="24"
                        Margin="4"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding ClearFiltersCommand}"
                        ToolTip="{loc:Translate Key=clear}">
                        <Image
                            Width="16"
                            Height="16"
                            Source="{StaticResource ResourceKey=IconClearFilters}" />
                    </Button>
                </Grid>

            </StackPanel>
        </Expander>
        <DataGrid
            x:Name="TransactionsGrid"
            Grid.Row="0"
            Grid.Column="0"
            Margin="5"
            dgx:DataGridFilter.IsAutoFilterEnabled="True"
            AutoGenerateColumns="False"
            CanUserAddRows="false"
            ClipboardCopyMode="ExcludeHeader"
            FontSize="14"
            IsReadOnly="True"
            IsSynchronizedWithCurrentItem="True"
            ItemsSource="{Binding Path=Entities}"
            ScrollViewer.CanContentScroll="True"
            SelectedItem="{Binding SelectedValue, UpdateSourceTrigger=Default}"
            SelectionMode="Extended"
            SelectionUnit="FullRow">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="SelectedCellsChanged">
                    <i:InvokeCommandAction Command="{Binding SelectionChangedCommand}" CommandParameter="{Binding SelectedCells, ElementName=TransactionsGrid}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>
            <DataGrid.InputBindings>
                <MouseBinding
                    Command="{Binding EditCommand}"
                    CommandParameter="{Binding SelectedValue}"
                    MouseAction="LeftDoubleClick" />
            </DataGrid.InputBindings>
            <DataGrid.Columns>
                <DataGridTextColumn dgx:DataGridFilterColumn.IsFilterVisible="False" Binding="{Binding Path=Id}" />
                <DataGridTemplateColumn
                    dgx:DataGridFilterColumn.IsFilterVisible="False"
                    ClipboardContentBinding="{Binding Path=Type}"
                    Header="">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image
                                Name="MyImage"
                                Width="20"
                                Height="20"
                                Source="{StaticResource IconSquareUpRight}" />
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Path=Type}" Value="Transfer">
                                    <Setter TargetName="MyImage" Property="Source" Value="{StaticResource IconUpRightAndDownLeftFromCenter}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Path=Type}" Value="Income">
                                    <Setter TargetName="MyImage" Property="Source" Value="{StaticResource IconSquareDownRight}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Path=Type}" Value="Share">
                                    <Setter TargetName="MyImage" Property="Source" Value="{StaticResource IconShareNodesRed}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn
                    dgx:DataGridFilterColumn.IsFilterVisible="False"
                    Binding="{Binding Path=Datetime, Converter={StaticResource DatetimeConverter}}"
                    Header="{loc:Translate Key=time}" />
                <DataGridTextColumn Binding="{Binding Path=AccountTitle}" Header="" />
                <DataGridTemplateColumn ClipboardContentBinding="{Binding Path=TransactionTitle}" Header="">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <emoji:EmojiedTextBlock x:Name="Cell" Text="{Binding Path=TransactionTitle}" />
                                <TextBlock
                                    x:Name="Separator"
                                    Text=" | "
                                    Visibility="{Binding Project, Converter={StaticResource ToVisibilityConverter}}" />
                                <emoji:EmojiedTextBlock
                                    x:Name="prj"
                                    Foreground="DarkGreen"
                                    Text="{Binding Project.Title}" />
                                <TextBlock
                                    x:Name="TagsSeparator"
                                    Text=" | "
                                    Visibility="{Binding Tags, Converter={StaticResource ToVisibilityConverter}}" />
                                <emoji:EmojiedTextBlock Text="{Binding TagsTitle}" Visibility="{Binding Tags, Converter={StaticResource ToVisibilityConverter}}" />
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Path=HasNoCategory}" Value="True">
                                    <Setter TargetName="Cell" Property="Background" Value="Pink" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Project.IsActive}" Value="False">
                                    <DataTrigger.Setters>
                                        <Setter TargetName="prj" Property="Foreground" Value="DarkRed" />
                                    </DataTrigger.Setters>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn
                    dgx:DataGridFilterColumn.IsFilterVisible="False"
                    ClipboardContentBinding="{Binding Path=AmountClipboardText}"
                    Header="{loc:Translate Key=amount}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock
                                Name="MyText"
                                HorizontalAlignment="Right"
                                Text="{Binding Path=AmountTitle}" />
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Path=Type}" Value="Transfer">
                                    <Setter TargetName="MyText" Property="Foreground" Value="DarkOrange" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Path=Type}" Value="Income">
                                    <Setter TargetName="MyText" Property="Foreground" Value="DarkGreen" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Path=Type}" Value="Share">
                                    <Setter TargetName="MyText" Property="Foreground" Value="DarkRed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Path=Type}" Value="Expense">
                                    <Setter TargetName="MyText" Property="Foreground" Value="DarkRed" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn
                    dgx:DataGridFilterColumn.IsFilterVisible="False"
                    Binding="{Binding Path=BalanceTitle}"
                    Header="{loc:Translate Key=balance}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Border
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="1"
            Margin="5,0,5,5"
            Padding="6,3"
            Background="#FFF0F0F0"
            BorderBrush="#FFCCCCCC"
            BorderThickness="1">
            <TextBlock
                HorizontalAlignment="Right"
                FontSize="14"
                FontWeight="Bold"
                Text="{Binding SelectionSummary}" />
        </Border>
    </Grid>
</UserControl>
